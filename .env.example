# RAG Nong Nghiep local configuration
# Copy this file to `.env` when you need local overrides.

# API keys are read by the backend only. Do not expose them in React.
GEMINI_API_KEY=your_gemini_api_key
COHERE_API_KEY=your_cohere_api_key
PINECONE_API_KEY=your_pinecone_api_key

# Optional Pinecone settings; config.yaml contains the same defaults.
PINECONE_INDEX_NAME=rag-nong-nghiep-cohere
PINECONE_NAMESPACE=rag_collection_cohere

# Comma-separated frontend origins for FastAPI CORS.
# Example: CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
